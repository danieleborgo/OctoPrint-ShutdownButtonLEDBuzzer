<form class="form-horizontal">
    <div class="control-group-header">
        <h3>ShutdownButtonLEDBuzzer</h3>
    </div>

    <div class="alert alert-error" data-bind="visible: has_pin_conflict" style="margin-bottom: 10px;">
        Two or more enabled components share the same pin. Resolve the conflict before saving.
    </div>

    <div class="control-group">
        This plugin uses <B>BCM</B> pins. <BR>
        To know more data about pins check
        <a href="https://plugins.octoprint.org/plugins/gpiostatus/" target="_blank">
        this plugin</a>.
    </div>

    <div class="control-group-header">
        <h4>Button setup</h4>
    </div>

    <div class="control-group">
        This button adds a hardware shutdown procedure to the Raspberry,
        without requiring any external resistor. <b>Remember to configure
        the shutdown command in the apposite OctoPrint section</b>.
    </div>

    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: shutdownButtonLEDBuzzer.is_button_en">
                {{ _("Enable button") }}
            </label>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('Button pin') }}</label>
        <div class="controls">
            <!-- ko ifnot: shutdownButtonLEDBuzzer.unlock_pin_range() -->
            <select data-bind="options: pin_options,
                               optionsText: 'text',
                               optionsValue: 'value',
                               value: shutdownButtonLEDBuzzer.button_pin,
                               enable: shutdownButtonLEDBuzzer.is_button_en,
                               optionsAfterRender: pin_after_render">
            </select>
            <!-- /ko -->
            <!-- ko if: shutdownButtonLEDBuzzer.unlock_pin_range() -->
            <input type="number" class="input-block-level center-input"
                   data-bind="value: shutdownButtonLEDBuzzer.button_pin,
                              enable: shutdownButtonLEDBuzzer.is_button_en"
                   style="text-align: center">
            <!-- /ko -->
        </div>
    </div>

    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: shutdownButtonLEDBuzzer.is_disabled_in_print,
                                  enable: shutdownButtonLEDBuzzer.is_button_en">
                {{ _("Disable button during printing") }}
            </label>
        </div>
    </div>

    <div class="control-group-header">
        <h4>LED setup</h4>
    </div>

    <div class="control-group">
        This LED is active since the plugin's startup process is completed
        until <B>the GPIO</B>, not the board, is shut down.
    </div>

    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: shutdownButtonLEDBuzzer.is_led_en">
                {{ _("Enable LED") }}
            </label>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('LED pin') }}</label>
        <div class="controls">
            <!-- ko ifnot: shutdownButtonLEDBuzzer.unlock_pin_range() -->
            <select data-bind="options: pin_options,
                               optionsText: 'text',
                               optionsValue: 'value',
                               value: shutdownButtonLEDBuzzer.led_pin,
                               enable: shutdownButtonLEDBuzzer.is_led_en,
                               optionsAfterRender: pin_after_render">
            </select>
            <!-- /ko -->
            <!-- ko if: shutdownButtonLEDBuzzer.unlock_pin_range() -->
            <input type="number" class="input-block-level center-input"
                   data-bind="value: shutdownButtonLEDBuzzer.led_pin,
                              enable: shutdownButtonLEDBuzzer.is_led_en"
                   style="text-align: center">
            <!-- /ko -->
        </div>
    </div>

    <div class="control-group-header">
        <h4>Buzzer setup</h4>
    </div>

    <div class="control-group">
        If buzzer is enabled, this plugin emits the startup sound
        whenever at least one parameter is modified and saved.
    </div>

    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: shutdownButtonLEDBuzzer.is_buzzer_en">
                {{ _("Enable buzzer") }}
            </label>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">Buzzer type</label>
        <div class="controls">
            <label class="text">
                <select style="text-align: center"
                        data-bind="enable: shutdownButtonLEDBuzzer.is_buzzer_en() && library_supports_pwm(),
                                   value: buzzer_type">
                    <option>Active</option>
                    <option>Passive</option>
                </select>
            </label>
        </div>
    </div>

    <div class="control-group" data-bind="visible: shutdownButtonLEDBuzzer.is_buzzer_en() && !library_supports_pwm()">
        <div class="controls">
            <span class="label label-info">
                Selected library does not support PWM. Passive buzzer is unavailable.
            </span>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('Buzzer MIDI note (for passive)') }}</label>
        <div class="controls">
            <label>
                <input type="number" min="35" max="107" class="input-block-level center-input"
                       data-bind="value: shutdownButtonLEDBuzzer.active_note,
                                  enable: shutdownButtonLEDBuzzer.is_buzzer_en() &&
                                          !shutdownButtonLEDBuzzer.is_buzzer_active() &&
                                          library_supports_pwm()"
                       style="text-align: center">
            </label>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('Buzzer pin') }}</label>
        <div class="controls">
            <!-- ko ifnot: shutdownButtonLEDBuzzer.unlock_pin_range() -->
            <select data-bind="options: pin_options,
                               optionsText: 'text',
                               optionsValue: 'value',
                               value: shutdownButtonLEDBuzzer.buzzer_pin,
                               enable: shutdownButtonLEDBuzzer.is_buzzer_en,
                               optionsAfterRender: pin_after_render">
            </select>
            <!-- /ko -->
            <!-- ko if: shutdownButtonLEDBuzzer.unlock_pin_range() -->
            <input type="number" class="input-block-level center-input"
                   data-bind="value: shutdownButtonLEDBuzzer.buzzer_pin,
                              enable: shutdownButtonLEDBuzzer.is_buzzer_en"
                   style="text-align: center">
            <!-- /ko -->
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('Beep duration (ms)') }}</label>
        <div class="controls">
            <label>
                <input type="number" class="input-block-level center-input"
                       data-bind="value: shutdownButtonLEDBuzzer.beep_ms,
                                  enable: shutdownButtonLEDBuzzer.is_buzzer_en"
                       style="text-align: center">
            </label>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('Beeps number on startup') }}</label>
        <div class="controls">
            <label>
                <input type="number" class="input-block-level center-input"
                       data-bind="value: shutdownButtonLEDBuzzer.beeps_on_startup,
                                  enable: shutdownButtonLEDBuzzer.is_buzzer_en"
                       style="text-align: center">
            </label>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('Beeps number on button pressed') }}</label>
        <div class="controls">
            <label>
                <input type="number" class="input-block-level center-input"
                       data-bind="value: shutdownButtonLEDBuzzer.beeps_on_pressed,
                                  enable: shutdownButtonLEDBuzzer.is_buzzer_en"
                       style="text-align: center">
            </label>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('Beeps number on shutdown') }}</label>
        <div class="controls">
            <label>
                <input type="number" class="input-block-level center-input"
                       data-bind="value: shutdownButtonLEDBuzzer.beeps_on_shutdown,
                                  enable: shutdownButtonLEDBuzzer.is_buzzer_en"
                       style="text-align: center">
            </label>
        </div>
    </div>

    <div class="control-group-header">
        <h4>Services enabled</h4>
    </div>

    <div class="control-group">
        Use this section to check if one of these is enabled.<BR>
        If set to <i>undefined</i> the server was unable to retrieve the information.
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('I2C') }}</label>
        <div class="controls">
            <label class="padding-top" data-bind="text: i2c_status,
            css: { 'label-enabled': i2c_status() == 'enabled',
                   'label-disabled': i2c_status() == 'disabled',
                   'label-undefined': i2c_status() == 'undefined' }">-</label>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('SPI') }}</label>
        <div class="controls">
            <label class="padding-top" data-bind="text: spi_status,
            css: { 'label-enabled': spi_status() == 'enabled',
                   'label-disabled': spi_status() == 'disabled',
                   'label-undefined': spi_status() == 'undefined' }">-</label>
        </div>
    </div>

    <div class="control-group">
        <div class="controls">
            <input type="button" class="btn btn-primary" data-bind="click: refresh" value="Refresh">
            <label class="update-label">Last on <span data-bind="text: updated_hour">-</span></label>
        </div>
    </div>


    <div class="control-group-header" style="cursor: pointer; user-select: none;"
         data-bind="click: function(){ advanced_expanded(!advanced_expanded()) }">
        <h4>
            <span data-bind="text: advanced_expanded() ? '▼' : '▶'"></span>
            Advanced Settings
        </h4>
    </div>

    <div data-bind="visible: advanced_expanded">

        <div class="control-group">
            <div class="alert alert-warning" style="margin-bottom: 0;">
                Only change these settings if the plugin is not working correctly.
                Choosing the wrong option will prevent the button, LED and buzzer from working.
            </div>
        </div>

        <div class="control-group-header">
            <h4>Pin Range</h4>
        </div>

        <div class="control-group">
            <!-- ko if: is_raspberry_pi() === true -->
            {{ _("Detected board: ") }}<b data-bind="text: board_model"></b>.
            {{ _("Pin range is restricted to BCM 2–27 (standard 40-pin header).") }}
            <!-- /ko -->
            <!-- ko if: is_raspberry_pi() === false -->
            <!-- ko if: board_model() -->
            {{ _("Detected board: ") }}<b data-bind="text: board_model"></b>.
            <!-- /ko -->
            <!-- ko ifnot: board_model() -->
            {{ _("Non-Raspberry Pi board detected.") }}
            <!-- /ko -->
            {{ _("Pin range is unlocked by default since BCM 2–27 may not apply to your hardware.") }}
            <!-- /ko -->
        </div>

        <div class="control-group">
            <div class="controls">
                <label class="checkbox">
                    <input type="checkbox"
                           data-bind="checked: shutdownButtonLEDBuzzer.unlock_pin_range">
                    {{ _("Unlock pin range (required for Compute Modules or non-Raspberry Pi hardware)") }}
                </label>
            </div>
        </div>

        <div class="control-group-header">
            <h4>GPIO Driver</h4>
        </div>

        <div class="control-group">
            The plugin needs a driver to communicate with the Raspberry Pi's physical pins.
            Different versions of Raspberry Pi OS require a different driver.<BR><BR>
            <b>Auto</b> is recommended: the plugin reads your OS version and picks the right
            driver automatically. You only need to change this if auto detection fails.<BR><BR>
            If you need to pick manually:
            <ul>
                <li><b>periphery</b> — for Raspberry Pi OS <b>Bookworm (2023)</b> or newer</li>
                <li><b>gpiozero</b> — for Raspberry Pi OS <b>Bullseye (2021)</b> or older</li>
            </ul>
            <!-- ko if: os_name() -->
            Your system is running: <b data-bind="text: os_name"></b>.<BR>
            <!-- /ko -->
            To find your OS version, run <code>cat /etc/os-release</code> on the Raspberry Pi
            and look for <code>VERSION_CODENAME</code>.
        </div>

        <div class="control-group">
            <label class="control-label">{{ _('Driver') }}</label>
            <div class="controls">
                <select data-bind="value: shutdownButtonLEDBuzzer.gpio_library"
                        style="display: inline-block; width: auto; margin-right: 6px;">
                    <option value="auto">Auto (recommended)</option>
                    <option value="periphery">periphery (Bookworm and newer)</option>
                    <option value="gpiozero">gpiozero (Bullseye and older)</option>
                </select>
                <button class="btn"
                        data-bind="click: on_check_click,
                                   disable: checking() || shutdownButtonLEDBuzzer.gpio_library() === 'auto'">
                    <span data-bind="visible: !checking()">Check</span>
                    <span data-bind="visible: checking()">Checking...</span>
                </button>
                <div data-bind="visible: check_message().length > 0,
                                text: check_message,
                                css: { 'text-success': check_success() === true,
                                       'text-error': check_success() === false }"
                     style="margin-top: 4px;"></div>
            </div>
        </div>

    </div>

</form>
